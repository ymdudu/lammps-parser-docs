var tipuesearch = {"pages":[{"title":" lammps-parser ","text":"lammps-parser Overview The project \" lammps-parser \" is a series of Fortran modules consisting of\na hierarchy of fundamental classes and routines, designed for parsing dump files\ngenerated by LAMMPS package and performing basic calculations frequently occurred\nin molecular dynamics simulation. To accelerate the computation, \" lammps-parser \" also supports parallelism\nbased on OpenMP for a few procedures with large computational scale. The project \" lammps-parser \" is mainly written in Fortran (2008) language\nand uses OOP techniques, enabling itself to have a great extensibility, although\nit is developed for the author's own research at the beginning. Usage Dependencies: GNU Fortran Intel oneAPI toolkits (particularly Intel Fortran Compiler and Intel MKL ) voro++ package The codes will be built as a (static or dynamic) library in folder \"lib/\". # Make sure that all dependencies have been installed and can be accessed by ${PATH}. # Suppose that the current working directory is the root directory of lammps-parser: cd src\nmake [ FC = ifx | gfortran ] After building the library \" liblammps-parser.a \" (or \" liblammps-parser.so \"),\neveryone will be able to write his/her source codes using the facilities provided by\n\"lammps-parser\" via linking to the library just created. Directory Structure lammps-parser/\n├── bash\n│   └── cut_voro_output.awk\n├── include\n├── lib\n├── samples\n├── src\n│   ├── atomics.f90\n│   ├── atomics_impl.f90\n│   ├── base.f90\n│   ├── baseframe.f90\n│   ├── baseframe_impl.f90\n│   ├── base_impl.f90\n│   ├── bondings.f90\n│   ├── bondings_impl.f90\n│   ├── box.f90\n│   ├── box_impl.f90\n│   ├── frames.f90\n│   ├── frames_impl.f90\n│   ├── linalg.f90\n│   ├── linalg_impl.f90\n│   ├── Makefile\n│   ├── maths.f90\n│   ├── maths_impl.f90\n│   ├── paths.f90\n│   ├── position.f90\n│   ├── position_impl.f90\n│   ├── statistic.f90\n│   ├── statistic_impl.f90\n│   ├── string.f90\n│   ├── string_impl.f90\n│   ├── type.f90\n│   ├── type_impl.f90\n│   ├── voro.f90\n│   └── voro_impl.f90\n└── tests\n    ├── baseframe\n    ├── frames\n    ├── linalg\n    ├── maths\n    ├── mechanic\n    └── statistic Note that the contents in each subfolder of /tests are omitted for brevity . Developer Info YiMing Du","tags":"home","url":"index.html"},{"title":"FramesHandler – lammps-parser ","text":"type, public :: FramesHandler Manage all infomation relating to Frames, i.e. a list of BaseFrames. Inherits type~~frameshandler~~InheritsGraph type~frameshandler FramesHandler type~baseframehandler BaseFrameHandler type~frameshandler->type~baseframehandler frames type~atomicshandler AtomicsHandler type~baseframehandler->type~atomicshandler atomics type~basehandler BaseHandler type~baseframehandler->type~basehandler type~bondingshandler BondingsHandler type~baseframehandler->type~bondingshandler bondings type~boxhandler BoxHandler type~baseframehandler->type~boxhandler box type~vorohandler VoroHandler type~baseframehandler->type~vorohandler voro StringHandler StringHandler type~atomicshandler->StringHandler atomic_list type~positionhandler PositionHandler type~atomicshandler->type~positionhandler pos type~typehandler TypeHandler type~atomicshandler->type~typehandler typ Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial type( BaseFrameHandler ), public, allocatable, dimension(:) :: frames The list of BaseFrames represented by an array Type-Bound Procedures procedure, public :: reallocFrames reallocate the \"Frames\". interface private module subroutine reallocFrames(this, ids) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this integer, intent(in), optional, dimension(:) :: ids procedure, public :: init reallocate and read data into \"frames\" from a file in dump format. interface private module subroutine init(this, filename, ids) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this character(len=*) :: filename integer, intent(in), optional, dimension(:) :: ids procedure, public :: readfrom read Frames information from a file in dump format. interface private module subroutine readfrom(this, filename, ids) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this character(len=*) :: filename integer, intent(in), optional, dimension(:) :: ids generic, public :: setnframes => setnframes_from_file , setnframes_manual set \"nframes\" by two ways: from file in dump format, or manual. private module subroutine setnframes_from_file(this, filename) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this character(len=*), intent(in) :: filename private module subroutine setnframes_manual(this, nframes) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this integer, intent(in) :: nframes procedure, public :: setnframes_from_file set \"nframes\" from a file in dump format. private module subroutine setnframes_from_file(this, filename) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this character(len=*), intent(in) :: filename procedure, public :: setnframes_manual set \"nframes\" manually. private module subroutine setnframes_manual(this, nframes) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this integer, intent(in) :: nframes procedure, public :: Dmin2 calculate the between two configurations. interface private module function Dmin2(this, ref_fr, distort_fr) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this integer, intent(in) :: ref_fr integer, intent(in) :: distort_fr Return Value real(kind=real64), allocatable, dimension(:) procedure, public :: dnn calculate the between two configurations. interface private module function dnn(this, ref_fr, distort_fr, identity) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(in) :: this integer, intent(in) :: ref_fr integer, intent(in) :: distort_fr logical, intent(in) :: identity Return Value integer, allocatable, dimension(:) procedure, public :: getnframes get \"nframes\". interface private module function getnframes(this) result(nframes) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(in) :: this Return Value integer procedure, public :: get_msd calculate the MSD (mean squared displacement). interface private module function get_msd(this) result(msd) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this Return Value real(kind=real64), allocatable, dimension(:) procedure, public :: get_loc_dwf calculate the LDWF (local Debye-Waller factor). interface private module function get_loc_dwf(this, timescale) result(loc_dwf) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this integer, intent(in), optional :: timescale Return Value real(kind=real64), allocatable, dimension(:) procedure, public :: writeDump write full Frames into a file in dump format. interface private module subroutine writeDump(this, filename, atomichead, atomicfmt, iarr, rarr, initonly) Arguments Type Intent Optional Attributes Name class( FramesHandler ), intent(inout) :: this character(len=*), intent(in) :: filename character(len=*), intent(in), optional :: atomichead character(len=*), intent(in), optional :: atomicfmt integer, optional, dimension(:,:,:) :: iarr real(kind=real64)
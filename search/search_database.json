odule function getnjtypatoms(this, jtyp, ids) result(njtypatoms) Arguments Type Intent Optional Attributes Name class( TypeHandler ), intent(in) :: this integer, intent(in) :: jtyp integer, optional, dimension(:) :: ids Return Value integer procedure, public :: getjtypids get the ids of all j-type atoms in a configuration. interface private module function getjtypids(this, jtyp) result(jtypids) Arguments Type Intent Optional Attributes Name class( TypeHandler ), intent(in) :: this integer, intent(in) :: jtyp Return Value integer, allocatable, dimension(:)","tags":"","url":"type/typehandler.html"},{"title":"AtomicsHandler – lammps-parser ","text":"type, public :: AtomicsHandler Manage all atomic parameters. Inherits type~~atomicshandler~~InheritsGraph type~atomicshandler AtomicsHandler StringHandler StringHandler type~atomicshandler->StringHandler atomic_list type~positionhandler PositionHandler type~atomicshandler->type~positionhandler pos type~typehandler TypeHandler type~atomicshandler->type~typehandler typ Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Inherited by type~~atomicshandler~~InheritedByGraph type~atomicshandler AtomicsHandler type~baseframehandler BaseFrameHandler type~baseframehandler->type~atomicshandler atomics type~frameshandler FramesHandler type~frameshandler->type~baseframehandler frames Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial type(StringHandler), public, allocatable, dimension(:) :: atomic_list The name list of the atomic properties type( TypeHandler ), public :: typ The type parameter type( PositionHandler ), public :: pos The (atom) positions real(kind=real64), public, allocatable, dimension(:, :) :: others Other atomic parameters appeared in the dump file Type-Bound Procedures procedure, public :: reallocAtomics reallocate \"typ\" and \"pos\" according to natoms, ndim. interface private module subroutine reallocAtomics(this, natoms, ndim) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this integer, intent(in) :: natoms integer, intent(in) :: ndim procedure, public :: realloc_atomic_list reallocate \"atomic_list\" according to natomics. interface private module subroutine realloc_atomic_list(this) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this procedure, public :: realloc_others reallocate \"others\" according to natoms, natomics. interface private module subroutine realloc_others(this, natoms, ndim) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this integer, intent(in) :: natoms integer, intent(in) :: ndim procedure, public :: setAtomics_from_file set all Atomics members from a file in dump format, with the help of natoms. interface private module subroutine setAtomics_from_file(this, fp, natoms, quit, bounds) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this integer, intent(in) :: fp integer, intent(in) :: natoms logical, intent(in) :: quit real(kind=real64), intent(in), optional, dimension(:, :) :: bounds generic, public :: setnatomics => setnatomics_from_str , setnatomics_manual set \"natomics\" by two ways: from string, or manual. private module subroutine setnatomics_from_str(this, atomics_str) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this character(len=*), intent(in) :: atomics_str private module subroutine setnatomics_manual(this, natomics) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this integer, intent(in) :: natomics procedure, public :: setnatomics_from_str set natomics according to atomic head str in a file of dump format. private module subroutine setnatomics_from_str(this, atomics_str) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this character(len=*), intent(in) :: atomics_str procedure, public :: setnatomics_manual set natomics manually. private module subroutine setnatomics_manual(this, natomics) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(inout) :: this integer, intent(in) :: natomics procedure, public :: getnatomics get natomics. interface private module function getnatomics(this) result(natomics) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(in) :: this Return Value integer procedure, public :: writeAtomics write Atomics information into stdout interface private module subroutine writeAtomics(this) Arguments Type Intent Optional Attributes Name class( AtomicsHandler ), intent(in) :: this","tags":"","url":"type/atomicshandler.html"},{"title":"VoroHandler – lammps-parser ","text":"type, public :: VoroHandler Manage all Voronoi tessellation information in a configuration. Inherited by type~~vorohandler~~InheritedByGraph type~vorohandler VoroHandler type~baseframehandler BaseFrameHandler type~baseframehandler->type~vorohandler voro type~frameshandler FramesHandler type~frameshandler->type~baseframehandler frames Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial integer, public, allocatable, dimension(:) :: nv The number of vertices in the Voronoi cell for each atom integer, public, allocatable, dimension(:) :: Z The coordination number of each atom obtained by Voronoi method integer, public, allocatable, dimension(:, :) :: coors The list of nearest neighbors for each atom obtained by Voronoi method integer, public, allocatable, dimension(:, :) :: voroindex The Voronoi index for each atom integer, public, allocatable, dimension(:) :: which_cluster The cluster id which each atom belongs to Type-Bound Procedures procedure, public :: realloc_nv reallocate the number of vertices \"nv\". interface private module subroutine realloc_nv(this, natoms) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this integer, intent(in) :: natoms procedure, public :: reallocZ reallocate the coordination number \"Z\". interface private module subroutine reallocZ(this, natoms) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this integer, intent(in) :: natoms procedure, public :: realloc_coors reallocate the nearest neighbor list \"coors\". interface private module subroutine realloc_coors(this, natoms, ncoor) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this integer, intent(in) :: natoms integer, intent(in) :: ncoor procedure, public :: realloc_voroindex reallocate the Voronoi index \"voroindex\". interface private module subroutine realloc_voroindex(this, natoms) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this integer, intent(in) :: natoms procedure, public :: realloc_which_cluster reallocate the cluster information \"which_cluster\". interface private module subroutine realloc_which_cluster(this, natoms) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this integer, intent(in) :: natoms procedure, public :: setnv_from_file set \"nv\" from file generated by \"gen_nv()\". interface private module subroutine setnv_from_file(this, fnv) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this character(len=*), intent(in) :: fnv generic, public :: setZ => setZ_from_file , setZ_manual set \"Z\" by two ways: from file generated by gen_Z(), or manual. private  interface setZ_from_file() Arguments None private  interface setZ_manual() Arguments None procedure, public :: setZ_from_file set \"Z\" from a file containing coordination numbers information. interface private module subroutine setZ_from_file(this, fz) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this character(len=*), intent(in) :: fz procedure, public :: setZ_manual set \"Z\" manually. interface private module subroutine setZ_manual(this) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this procedure, public :: set_coors_from_file set \"coors\" from a file containing nearest neighbor information. interface private module subroutine set_coors_from_file(this, fcoor) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this character(len=*), intent(in) :: fcoor procedure, public :: set_voroindex_from_file set \"voroindex\" from a file containing Voronoi index information. interface private module subroutine set_voroindex_from_file(this, fvoroindex) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this character(len=*), intent(in) :: fvoroindex procedure, public :: set_which_cluster set \"which_cluster\" according to \"Z\" and \"coors\" for a given subset of atoms. interface private module subroutine set_which_cluster(this, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(inout) :: this integer, intent(in), dimension(:) :: ids procedure, public :: get_clustersize get the sizes of all clusters. interface private module function get_clustersize(this) result(clustersize) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this Return Value integer, allocatable, dimension(:) procedure, public :: write_clusterinfo write the detailed cluster information (cluster id, and its component) into a file. interface private module subroutine write_clusterinfo(this, filename) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this character(len=*), intent(in) :: filename procedure, public :: write_clustersize_pmf write the pmf (probability mass function) of cluster sizes. interface private module subroutine write_clustersize_pmf(this, filename) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this character(len=*), intent(in) :: filename procedure, public :: getncoor get the maximum of the coordination numbers in the configuration. interface private module function getncoor(this) result(ncoor) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this Return Value integer procedure, public :: get_locf5 get the local fivefold symmetry for each atom in the configuration. interface private module function get_locf5(this) result(loc_f5) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this Return Value real(kind=real64), allocatable, dimension(:) procedure, public :: voroindex_statistic statistics on the Voronoi index of different subgroups of atoms in a configuration,\nand write them into a file. Note The subgroup is specified by the number of subgroups \"nsubgrps\", and an ordered list\nof ids of atoms \"ids\". interface private module subroutine voroindex_statistic(this, filename, ids, nsubgrps) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this character(len=*), intent(in) :: filename integer, intent(in), dimension(:) :: ids integer, intent(in) :: nsubgrps procedure, public :: voroindex_histogram write the Voronoi indices spectrum of a subgroup of atoms in a configuration into a file. Note The spectrum is a fixed list of Voronoi indices appeared frequently. interface private module subroutine voroindex_histogram(this, filename, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this character(len=*), intent(in) :: filename integer, intent(in), dimension(:) :: ids procedure, public :: f_0_3_6_0 interface private module function f_0_3_6_0(this, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this integer, intent(in), dimension(:) :: ids Return Value real(kind=real64) procedure, public :: f_0_4_4_1 interface private module function f_0_4_4_1(this, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this integer, intent(in), dimension(:) :: ids Return Value real(kind=real64) procedure, public :: f_0_2_8_0 interface private module function f_0_2_8_0(this, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this integer, intent(in), dimension(:) :: ids Return Value real(kind=real64) procedure, public :: f_0_3_6_1 interface private module function f_0_3_6_1(this, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this integer, intent(in), dimension(:) :: ids Return Value real(kind=real64) procedure, public :: f_0_4_4_2 interface private module function f_0_4_4_2(this, ids) Arguments Type Intent Optional Attributes Name class( VoroHandler ), intent(in) :: this integer, intent(in), dimension(:) :
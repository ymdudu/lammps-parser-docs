nsion(:) private module function dsortd(arr) result(ids) descending sort for double array. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arr Return Value integer, allocatable, dimension(:)","tags":"","url":"interface/dsort.html"},{"title":"asort – lammps-parser","text":"public interface asort ascending sort procedure. Functions private module function asorti(arr) result(ids) ascending sort for integer array. Arguments Type Intent Optional Attributes Name integer, intent(in), dimension(:) :: arr Return Value integer, allocatable, dimension(:) private module function asorts(arr) result(ids) ascending sort for single array. Arguments Type Intent Optional Attributes Name real(kind=real32), intent(in), dimension(:) :: arr Return Value integer, allocatable, dimension(:) private module function asortd(arr) result(ids) ascending sort for double array. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arr Return Value integer, allocatable, dimension(:)","tags":"","url":"interface/asort.html"},{"title":"pearson_corr – lammps-parser","text":"interface public module function pearson_corr(arrx, arry) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arrx real(kind=real64), intent(in), dimension(:) :: arry Return Value real(kind=real64) Description calculate the Pearson correlation coefficient.","tags":"","url":"interface/pearson_corr.html"},{"title":"spearman_corr – lammps-parser","text":"interface public module function spearman_corr(arrx, arry, rank_mode) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arrx real(kind=real64), intent(in), dimension(:) :: arry integer, intent(in), optional :: rank_mode Return Value real(kind=real64) Description calculate the Spearman rank correlation coefficient.","tags":"","url":"interface/spearman_corr.html"},{"title":"get_rank – lammps-parser","text":"interface public module function get_rank(arr, rank_mode) result(rank) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arr integer, intent(in) :: rank_mode Return Value real(kind=real64),allocatable,dimension(:) Description get the rank for each element in an array, according to an integer \"rank_mode\". Note Different rank mode can be specified: rank_mode = 0 (default), fractional ranking (\"1 2.5 2.5 4\" ranking) rank_mode = 1, std competition ranking (\"1224\" ranking) rank_mode = 2, mod competition ranking (\"1334\" ranking)","tags":"","url":"interface/get_rank.html"},{"title":"Ylm – lammps-parser","text":"interface public elemental module function Ylm(l, m, theta, phi) Arguments Type Intent Optional Attributes Name integer, intent(in) :: l integer, intent(in) :: m real(kind=real64), intent(in) :: theta real(kind=real64), intent(in) :: phi Return Value complex(kind=real64) Description The (orthonormalized complex) spherical harmonics (employed with Condon-Shortley phase).","tags":"","url":"interface/ylm.html"},{"title":"cart2theta – lammps-parser","text":"interface public elemental module function cart2theta(x, y, z) result(theta) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x real(kind=real64), intent(in) :: y real(kind=real64), intent(in) :: z Return Value real(kind=real64) Description The transformation from 3d cartesian coordinates to the polar angle . Note","tags":"","url":"interface/cart2theta.html"},{"title":"cart2phi – lammps-parser","text":"interface public elemental module function cart2phi(x, y) result(phi) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x real(kind=real64), intent(in) :: y Return Value real(kind=real64) Description The transformation from 3d cartesian coordinates to the azimuthal angle . Note is redundant, hence is not included as argument.","tags":"","url":"interface/cart2phi.html"},{"title":"elim_periodic – lammps-parser","text":"in
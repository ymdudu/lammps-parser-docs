 :: arr Return Value integer, allocatable, dimension(:) private module function asorts(arr) result(ids) ascending sort for single array. Arguments Type Intent Optional Attributes Name real(kind=real32), intent(in), dimension(:) :: arr Return Value integer, allocatable, dimension(:) private module function asortd(arr) result(ids) ascending sort for double array. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arr Return Value integer, allocatable, dimension(:) interface public module function pearson_corr(arrx, arry) calculate the Pearson correlation coefficient. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arrx real(kind=real64), intent(in), dimension(:) :: arry Return Value real(kind=real64) interface public module function spearman_corr(arrx, arry, rank_mode) calculate the Spearman rank correlation coefficient. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arrx real(kind=real64), intent(in), dimension(:) :: arry integer, intent(in), optional :: rank_mode Return Value real(kind=real64) interface public module function get_rank(arr, rank_mode) result(rank) get the rank for each element in an array, according to an integer \"rank_mode\". Note Different rank mode can be specified: rank_mode = 0 (default), fractional ranking (\"1 2.5 2.5 4\" ranking) rank_mode = 1, std competition ranking (\"1224\" ranking) rank_mode = 2, mod competition ranking (\"1334\" ranking) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: arr integer, intent(in) :: rank_mode Return Value real(kind=real64), allocatable, dimension(:) Derived Types type, public :: ipmf1d Manage the 1d pmf of integer random variable. Components Type Visibility Attributes Name Initial real(kind=real64), public, allocatable, dimension(:,:) :: pmf Type-Bound Procedures procedure, public :: reallocpmf procedure, public :: setValid => s